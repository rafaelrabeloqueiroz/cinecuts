# --- Modo demo ---
# true (padrão): libera assinatura de teste sem Stripe e simula a publicação no
# Instagram quando não há credenciais da Meta. Defina "false" em produção.
DEMO_MODE=true

# --- Database ---
DATABASE_URL="postgresql://cinecuts:cinecuts@localhost:5432/cinecuts"

# --- Redis (fila de jobs) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# --- Admin inicial (usado pelo seed) ---
ADMIN_EMAIL="admin@cinecuts.local"
ADMIN_PASSWORD="troque-esta-senha"

# --- Storage ---
# "local" grava em ./storage e serve via /api/media (não precisa de nuvem).
# "s3" usa um bucket S3-compatible (AWS S3, Cloudflare R2, etc.).
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="storage"

STORAGE_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="cinecuts-media"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- Stripe (opcional: sem isso o checkout fica só como casca) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Instagram / Meta Graph API (opcional: sem isso a postagem é simulada) ---
# Requer: conta Instagram Profissional ligada a uma Página do Facebook, App na
# Meta com a permissão instagram_content_publish e token de longa duração.
META_APP_ID=""
META_APP_SECRET=""
IG_BUSINESS_ACCOUNT_ID=""
IG_LONG_LIVED_ACCESS_TOKEN=""
SUBSCRIBE_LINK_IN_BIO="https://cinecuts.example.com/assinar"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
