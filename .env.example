# --- Database ---
DATABASE_URL="postgresql://cinecuts:cinecuts@localhost:5432/cinecuts"

# --- Redis (job queue) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_MONTHLY="price_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Object storage (S3-compatible: AWS S3, Cloudflare R2, etc.) ---
STORAGE_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
STORAGE_REGION="auto"
STORAGE_BUCKET="cinecuts-media"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Public base URL from which uploaded files are served (CDN / bucket public domain)
STORAGE_PUBLIC_BASE_URL="https://media.example.com"

# --- Instagram / Meta Graph API ---
# Requires: Instagram Professional (Business/Creator) account linked to a Facebook Page,
# a Meta App with instagram_content_publish permission, and a long-lived access token.
META_APP_ID=""
META_APP_SECRET=""
IG_BUSINESS_ACCOUNT_ID=""
IG_LONG_LIVED_ACCESS_TOKEN=""
SUBSCRIBE_LINK_IN_BIO="https://cinecuts.example.com/assinar"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
